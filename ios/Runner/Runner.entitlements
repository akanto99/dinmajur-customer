<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.dinmajurplatformservice.dinmajurcustomer.onesignal</string>
	</array>
	<!-- Referral link (Refer & Earn) — Universal Links placeholder. Requires
	     a live apple-app-site-association file hosted at
	     https://customer.dinmajur.com/.well-known/apple-app-site-association
	     (with this app's Team ID + bundle ID) before iOS will honor this, and
	     the "Associated Domains" capability must also be enabled for this
	     target in Xcode (this entitlement alone isn't sufficient). Left
	     commented out until the real domain + AASA file exist, so an
	     unresolvable domain doesn't sit in a shipped build. -->
	<!--
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:customer.dinmajur.com</string>
	</array>
	-->
</dict>
</plist>
